# Space Basic server environment.
# Copy to server/.env.development for local overrides. Never commit real values.
# Every variable is validated at startup (src/config/env.ts): a missing or wrong one stops the server with a message.
#
# PRODUCTION (Render; render.yaml sets most of these, README "Deployment" walks through the rest):
#   NODE_ENV=production                 set by render.yaml
#   PORT                                set by Render itself (don't add it)
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spacebasic?retryWrites=true&w=majority
#                                       entered in the Render dashboard (Atlas user with readWrite on "spacebasic" only)
#   JWT_ACCESS_SECRET, QR_TOKEN_SECRET, OTP_PEPPER
#                                       generated by Render (render.yaml generateValue). To make one yourself:
#                                       node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   APP_ORIGINS=https://<project>.vercel.app     entered in the Render dashboard; https only, no trailing slash
#   COOKIE_SECURE=true                  set by render.yaml
#   CLIENT_IP_HEADER=x-real-ip          set by render.yaml: the visitor's address, from a header Vercel sets itself
#   TRUST_PROXY=3                       set by render.yaml: fallback; check both with https://<app>/api/v1/health/client
#   OTP_PROVIDER                        not set = email + password sign-in only (one-time codes off)
#   ALLOW_CONSOLE_OTP, RELAX_RATE_LIMITS, GMAIL_USER, GMAIL_APP_PASSWORD   never in production
#   GMAIL_API_*                         only when email one-time codes are turned on later (OTP_PROVIDER=gmail-api)
#   BCRYPT_COST                         leave unset (12)
# The client (Vercel) needs no environment variables: /api is rewritten to Render by vercel.json.

# development | test | production
NODE_ENV=development
PORT=4000

# --- database ---
# Development: leave empty to use the local dev MongoDB started by `npm run dev`
# (mongodb-memory-server, data kept in server/.data/, fake data seeded on first start).
# Production: required. MongoDB Atlas URI for a least-privilege user.
MONGODB_URI=

# --- secrets: required in production, at least 32 random characters each ---
# Development generates throwaway values when these are empty.
JWT_ACCESS_SECRET=
QR_TOKEN_SECRET=
OTP_PEPPER=

# --- web origins allowed for CORS and the refresh-cookie Origin check (comma separated) ---
APP_ORIGINS=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false
# number of proxy hops in front of the API (production: Vercel's rewrite + Render's load balancer = 2; check it with
# GET /api/v1/health/client, whose "ip" must be the caller's own address)
TRUST_PROXY=0

# --- OTP delivery: console | gmail-api | gmail-smtp ---
# Empty = OTP sign-in disabled; email + password sign-in still works.
OTP_PROVIDER=console
# Production only: allow the console provider for demo deployments with FAKE users.
ALLOW_CONSOLE_OTP=false

# Development and tests only: raise the sign-in and code rate limits for repeated local smoke runs
# (`npm run dev:relaxed` sets it for you). Refused when NODE_ENV=production; production limits never change.
RELAX_RATE_LIMITS=false

# gmail-smtp: LOCAL DEVELOPMENT ONLY (SMTP is blocked on Render's free tier)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# gmail-api: production email (OAuth2 client + refresh token of the sending Gmail account; see README)
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=

# bcrypt cost factor (tests use 4)
BCRYPT_COST=12
